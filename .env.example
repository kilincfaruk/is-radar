# Hepsi opsiyonel. Dosyayı .env olarak kopyala.
PORT=4545
# Skorlama motoru: "claude-cli" (Max aboneliğiyle `claude -p`, varsayılan) | "api" | "none"
SCORER=claude-cli
CLAUDE_CLI=claude
CLAUDE_MODEL=sonnet
# İkinci görüş: ilk geçişte skor ≥ TOP_MIN_SCORE olan ilanları bu model yeniden okur, ön yazı ve şirket araştırması da bununla yazılır.
# Boş = ikinci görüş kapalı. Opus kotayı belirgin daha hızlı yer; tur başına TOP_BUDGET_PER_RUN ile sınırla.
CLAUDE_MODEL_TOP=opus
TOP_MIN_SCORE=60
# Bu skorun üstü zaten net "evet": ikinci okuma sadece TOP_MIN_SCORE..TOP_MAX_SCORE bandına harcanır.
TOP_MAX_SCORE=84
TOP_BUDGET_PER_RUN=15
# SCORER=api ise:
ANTHROPIC_API_KEY=
# Tur başına LLM skorlama tavanı (0 = sınırsız) ve paralel claude süreci sayısı
SCORE_BUDGET_PER_RUN=60
# Skorlama metin çekmeyle paralel yürür; 3-4 paralel claude süreci Max planında sorun çıkarmıyor
SCORE_CONCURRENCY=3
# Bir claude çağrısında kaç ilan birlikte okunur (1-6). 3 = süreç ve sistem prompt'u 3'te bire iner; model bir ilanı atlarsa tek tek tamamlanır
SCORE_BATCH=3
# Şirket araştırması: skor eşiği (bu ve üstü otomatik araştırılır; 0 = kapalı)
RESEARCH_MIN_SCORE=70
# Tazelik kontrolü: shortlist/başvurdum/görüşme ve skoru LIVENESS_MIN_SCORE üstü yeni ilanlar 3 günde bir yeniden çekilir,
# "artık başvuru kabul etmiyor" olanlar kapandı diye işaretlenir. Tur başına en fazla bu kadar istek.
LIVENESS_BUDGET_PER_RUN=15
LIVENESS_MIN_SCORE=70
# Telegram bildirimi (bot token + chat id) — boşsa kapalı. Mesajda skor, özet, ilk artı/eksi ve link gider.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_MIN_SCORE=80
# HTML rapor: her tur sonunda data/reports/ altına tek dosyalık rapor (latest.html + tarihli kopya). 0 = kapalı.
REPORT_AFTER_RUN=1
# Saklanacak tarihli rapor sayısı (eskiler silinir)
REPORT_KEEP=30
